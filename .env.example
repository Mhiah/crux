# SERV Reasoning (OpenAI-compatible). Without it, the app runs on mock fixtures.
SERV_API_KEY=
# SERV_MODEL=gpt-5.4-mini
# Re-check each stage's output with SERV's shadow agent (extra calls per stage).
# SERV_SHADOW_AGENT=1

# Web search for the research stage. Without it, research uses mock sources.
TAVILY_API_KEY=

# Force mock mode even when keys are set.
# CRUX_MOCK=1

# Season 2 independent review, disabled by default to prevent anonymous paid evaluations.
REPPO_API_KEY=
# REPPO_REVIEW_ENABLED=1
# Private owner-only review token (24+ random characters; do not commit actual value).
CRUX_REVIEW_ACCESS_TOKEN=

# Optional persistent storage for Vercel (Upstash Redis REST); configure both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
