# SERV Reasoning (OpenAI-compatible). Without it, the app runs on mock fixtures.
SERV_API_KEY=
# SERV_MODEL=gpt-5.4-mini
# Re-check each stage's output with SERV's shadow agent (extra calls per stage).
# SERV_SHADOW_AGENT=1

# Web search for the research stage. Without it, research uses mock sources.
TAVILY_API_KEY=

# Force mock mode even when keys are set.
# CRUX_MOCK=1

# Storage. Without these, projects are saved as JSON files in .data/projects.
# With both set, they're saved in Supabase: run supabase/migrations/*.sql once in the
# Supabase SQL editor first. Use the project's secret key (or legacy service_role key);
# it stays on the server and is never sent to the browser.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
