# SERV Reasoning (OpenAI-compatible). Without it, the app runs on mock fixtures.
SERV_API_KEY=
# SERV_MODEL=gpt-5.4-mini
# Re-check each stage's output with SERV's shadow agent (extra calls per stage).
# SERV_SHADOW_AGENT=1

# Web search for the research stage. Without it, research uses mock sources.
TAVILY_API_KEY=

# Force mock mode even when keys are set.
# CRUX_MOCK=1

# Season 2 independent review, disabled by default to prevent anonymous paid evaluations.
REPPO_API_KEY=
# REPPO_REVIEW_ENABLED=1
# Optional private owner key (24+ random characters; do not commit the value). Skips the daily review allowances.
CRUX_REVIEW_ACCESS_TOKEN=

# Persistent storage in Vercel Preview. Vercel's Redis integration may automatically
# inject the KV_* pair; never copy actual values into this file or GitHub.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Alternatively use the direct Upstash pair (provide both):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
